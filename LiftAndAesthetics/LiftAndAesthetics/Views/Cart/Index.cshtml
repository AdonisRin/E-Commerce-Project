@model IEnumerable<LiftAndAesthetics.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
    decimal cartTotal = ViewBag.CartTotal ?? 0;
}

<div class="container-fluid text-center py-5 shadow-sm" style="background: linear-gradient(rgba(10,12,16,0.9), rgba(10,12,16,0.95)), url('https://images.unsplash.com/photo-1540497077202-7c8a3999166f?q=80&w=2070') center/cover; border-bottom: 2px solid #222632;">
    <h1 class="font-bebas display-2 text-uppercase text-white" style="letter-spacing: 3px;">Your Cart</h1>
    <p class="font-montserrat lead fw-bold text-light opacity-75 text-uppercase" style="letter-spacing: 1px;">Review your items and complete your order.</p>
</div>

<div class="container mt-5 mb-5 pt-3">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            @if (!Model.Any())
            {
                <div class="p-5 text-center rounded-3 shadow-sm" style="background: #141721; border: 1px solid #282e3e; border-top: 4px solid #dc3545;">
                    <h2 class="font-bebas text-white" style="font-size: 2.5rem; letter-spacing: 2px;">YOUR CART IS EMPTY</h2>
                    <p class="font-montserrat lead text-secondary fw-semibold mb-4">You haven't added any supplements, gear, or apparel yet.</p>
                    <a href="/Shop" class="font-bebas btn btn-danger fs-4 px-5 py-2 text-uppercase" style="letter-spacing: 1px;">Browse Shop</a>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0" style="background: #141721; border-radius: 8px; border: 1px solid #282e3e;">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0 align-middle font-montserrat" style="background: transparent;">
                                <thead class="font-bebas fs-5 text-danger" style="letter-spacing: 1px; border-bottom: 2px solid #dc3545;">
                                    <tr>
                                        <th class="ps-4 py-3">Product</th>
                                        <th class="py-3">Name</th>
                                        <th class="py-3 text-center">Price</th>
                                        <th class="py-3 text-center">Quantity</th>
                                        <th class="py-3 text-center">Subtotal</th>
                                        <th class="text-center py-3 pe-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var subtotal = (item.Product?.Price ?? 0) * item.Quantity;
                                        <tr style="border-bottom: 1px solid #242938;">
                                            <td class="ps-4 py-3">
                                                <div class="bg-white rounded d-flex justify-content-center align-items-center" style="width: 55px; height: 55px; border: 1px solid #3b4356;">
                                                    <img src="@(string.IsNullOrEmpty(item.Product?.ImageUrl) ? "https://via.placeholder.com/50" : item.Product.ImageUrl)" style="max-height: 48px; object-fit: contain;" class="rounded" alt="@item.Product?.Name">
                                                </div>
                                            </td>
                                            <td class="fw-bold text-white fs-5">@(item.Product?.Name ?? "Unknown")</td>
                                            <td class="text-secondary text-center fw-bold">@(item.Product?.Price.ToString("0.00") ?? "0.00") LEI</td>

                                            <td class="text-center" style="width: 160px;">
                                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center align-items-center gap-1 m-0">
                                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control text-center px-1 fs-6 text-white fw-bold" style="width: 60px; height: 36px; background: #1c212e; border: 1px solid #3b4356;" required />
                                                    <button type="submit" class="btn btn-outline-warning btn-sm font-bebas px-2 fs-6" style="height: 36px;" title="Update Quantity">Update</button>
                                                </form>
                                            </td>

                                            <td class="text-danger text-center fw-bold fs-5">@subtotal.ToString("0.00") LEI</td>
                                            <td class="text-center pe-4">
                                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                    <button type="submit" class="font-bebas btn btn-sm btn-outline-danger fs-6 px-3">
                                                        Remove
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer border-top p-4 p-md-5" style="background: #10131a; border-color: #282e3e !important;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">

                            <div class="text-center text-md-start">
                                <span class="font-montserrat text-secondary fw-bold text-uppercase d-block" style="letter-spacing: 1px; font-size: 0.9rem;">Order Total</span>
                                <h1 class="font-bebas text-danger mb-0" style="font-size: 3rem; letter-spacing: 2px;">
                                    @cartTotal.ToString("0.00") <span class="fs-4 text-white">LEI</span>
                                </h1>
                            </div>

                            <div class="d-flex flex-column gap-2 w-100" style="max-width: 280px;">
                                <form asp-controller="Cart" asp-action="Checkout" method="post">
                                    <button type="submit" class="font-bebas btn btn-danger fs-4 w-100 py-3 shadow text-uppercase" style="letter-spacing: 1px;">
                                        Proceed to Checkout
                                    </button>
                                </form>
                                <a href="/Shop" class="font-bebas btn btn-outline-secondary fs-5 w-100 py-2 text-white">Continue Shopping</a>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>