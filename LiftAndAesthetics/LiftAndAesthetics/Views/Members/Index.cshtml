@model IEnumerable<LiftAndAesthetics.Models.Members>

@{
    ViewData["Title"] = "Admin - Members";
}
<div class="container-fluid text-center py-5 shadow-lg" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%); border-bottom: 3px solid #0dcaf0;">
    <h1 class="font-bebas display-2 text-uppercase text-crisp-white glitch-text" style="letter-spacing: 4px; text-shadow: 0 0 20px rgba(13, 202, 240, 0.5);"> Members Database</h1>
    <p class="font-montserrat lead fw-bold text-crisp-white opacity-75 text-uppercase" style="letter-spacing: 1px;">Manage gym members, roles, and subscriptions.</p>
</div>

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="font-bebas text-white text-hologram" style="letter-spacing: 2px;">All Registered Users</h3>
        <a href="/Members/Create" class="font-bebas btn btn-liquid btn-outline-info fs-4 px-4 py-2" style="letter-spacing: 1px;"> Add New Member</a>
    </div>

    @if (!Model.Any())
    {
        <div class="p-5 text-center rounded-4 shadow-lg card-cyber-glow" style="background: #0a0a0a; border: 1px solid #333; border-top: 5px solid #0dcaf0;">
            <h1 class="display-1 text-info mb-4 glitch-text"></h1>
            <h2 class="font-bebas text-crisp-white text-hologram" style="font-size: 3rem; letter-spacing: 2px;">NO MEMBERS YET</h2>
            <p class="font-montserrat lead text-secondary fw-bold">Waiting for people to sign up.</p>
        </div>
    }
    else
    {
        <div class="card-cyber-glow bg-black p-0" style="border: 1px solid #333 !important; border-radius: 15px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 font-montserrat">
                    <thead class="font-bebas fs-4 text-info" style="letter-spacing: 1px; border-bottom: 2px solid #0dcaf0;">
                        <tr>
                            <th class="py-3 px-4">Name</th>
                            <th class="py-3 px-4">Email Address</th>
                            <th class="py-3 px-4">Membership Plan</th>
                            <th class="py-3 px-4 text-center">Role</th>
                            <th class="py-3 px-4 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid #222;">
                                <td class="px-4 fw-bold text-white fs-5 text-hologram">@item.Name</td>
                                <td class="px-4 text-secondary fw-bold">@item.Email</td>

                                <td class="px-4">
                                    <span class="badge bg-dark border border-secondary text-crisp-white px-3 py-2 fs-6 shadow-sm">
                                        @(item.Membership != null ? item.Membership.Name : "No Active Plan")
                                    </span>
                                </td>

                                <td class="px-4 text-center">
                                    @if (item.Role == "Admin")
                                    {
                                        <span class="badge bg-danger text-white font-bebas px-3 py-1 fs-5 shadow-lg" style="letter-spacing: 1.5px; border: 1px solid #ff4d4d;">ADMIN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark font-bebas px-3 py-1 fs-5" style="letter-spacing: 1px;">USER</span>
                                    }
                                </td>

                                <td class="px-4 text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/Members/Edit/@item.MemberId" class="font-bebas btn btn-sm btn-outline-warning fs-5 px-3">Edit</a>
                                        <a href="/Members/Details/@item.MemberId" class="font-bebas btn btn-sm btn-outline-info fs-5 px-3">MANAGE</a>
                                        <a href="/Members/Delete/@item.MemberId" class="font-bebas btn btn-sm btn-outline-danger fs-5 px-3">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>