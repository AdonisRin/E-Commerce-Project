@model LiftAndAesthetics.Models.Members

@{
    ViewData["Title"] = "Add Member";
}

<div class="container-fluid text-center py-5 shadow-lg" style="background: linear-gradient(rgba(10,10,10,0.85), rgba(10,10,10,0.95)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070') center/cover; border-bottom: 3px solid #0dcaf0;">
    <h1 class="font-bebas display-2 text-uppercase text-crisp-white glitch-text" style="letter-spacing: 4px; text-shadow: 0 0 20px rgba(13, 202, 240, 0.5);"> Add New Member</h1>
    <p class="font-montserrat lead fw-bold text-crisp-white opacity-75 text-uppercase" style="letter-spacing: 1px;">Register a user manually from the front desk.</p>
</div>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="p-4 p-md-5 rounded-4 shadow-lg card-cyber-glow" style="background: linear-gradient(145deg, #111 0%, #050a1a 100%); border: 1px solid #333; border-top: 5px solid #0dcaf0;">

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold font-montserrat mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Name" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Full Name</label>
                            <input asp-for="Name" class="form-control input-hologram font-montserrat p-3" placeholder="e.g. John Doe" required />
                            <span asp-validation-for="Name" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Email" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control input-hologram font-montserrat p-3" placeholder="john@email.com" required />
                            <span asp-validation-for="Email" class="text-danger font-montserrat small fw-bold"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label font-montserrat text-warning fw-bold text-uppercase" style="letter-spacing: 1px;">Role / Access Level</label>
                            <select name="UserRole" class="form-select input-hologram font-montserrat p-3" style="background: #000;">
                                <option value="User">User (Normal Member)</option>
                                <option value="Admin">Admin (Staff / Manager)</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="MembershipId" class="form-label font-montserrat text-info fw-bold text-uppercase" style="letter-spacing: 1px;">Assign Membership</label>
                            <select asp-for="MembershipId" class="form-select input-hologram font-montserrat p-3" style="background: #000;" asp-items="ViewBag.MembershipId">
                                <option value="">-- No Active Plan --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label font-montserrat text-neon-red fw-bold text-uppercase" style="letter-spacing: 1px;">Temporary Initial Password</label>
                        <input asp-for="Password" type="text" class="form-control input-hologram font-montserrat p-3" placeholder="Give this to the user to log in..." required />
                        <span asp-validation-for="Password" class="text-danger font-montserrat small fw-bold d-block mt-1"></span>
                        <small class="text-muted font-montserrat fw-bold mt-1 d-block">Will be hashed automatically upon save.</small>
                    </div>

                    <div class="d-flex gap-3 mt-4 pt-3 border-top border-secondary">
                        <button type="submit" class="font-bebas btn btn-info fs-3 px-5 py-2 flex-grow-1" style="letter-spacing: 2px; color: #000 !important;">Save Member</button>
                        <a href="/Members" class="font-bebas btn btn-outline-light fs-3 px-5 py-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}