@model IEnumerable<LiftAndAesthetics.Models.ContactMessage>

@{
    ViewData["Title"] = "Messages Inbox";
}

<div class="container-fluid text-center py-5 shadow-lg" style="background: linear-gradient(135deg, #111 0%, #000 100%); border-bottom: 3px solid #ff2a2a;">
    <h1 class="font-bebas display-3 text-uppercase text-crisp-white glitch-text" style="letter-spacing: 3px; text-shadow: 0 0 20px rgba(255, 42, 42, 0.8);">
        <span class="text-neon-red"></span> Messages Inbox
    </h1>
    <p class="font-montserrat lead fw-bold text-crisp-white opacity-75 text-uppercase" style="letter-spacing: 1px;">Manage visitors' inquiries and feedback</p>
</div>

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 bg-black card-cyber-glow" style="border-radius: 15px;">
        <div class="card-body p-0">
            <div class="table-responsive" style="border-radius: 15px;">
                <table class="table table-dark table-hover mb-0 align-middle font-montserrat">
                    <thead class="font-bebas fs-4 text-neon-red" style="letter-spacing: 1px; border-bottom: 2px solid #ff2a2a;">
                        <tr>
                            <th class="ps-4 py-3">Date</th>
                            <th class="py-3">Sender</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Message</th>
                            <th class="text-center py-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <h3 class="font-bebas text-crisp-white opacity-50" style="letter-spacing: 2px;"> Your inbox is empty. No messages yet.</h3>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid #333;">
                                    <td class="ps-4 text-crisp-white opacity-75 fw-bold small">
                                        @item.SentDate.ToString("dd MMM yyyy, HH:mm")
                                    </td>
                                    <td class="fw-bold text-crisp-white fs-5 text-hologram">@item.SenderName</td>
                                    <td class="text-neon-red fw-bold">@item.SenderEmail</td>
                                    <td style="max-width: 350px;">
                                        <div class="text-truncate text-crisp-white opacity-75" title="@item.MessageContent">
                                            @item.MessageContent
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="mailto:@item.SenderEmail?subject=Reply from Lift & Aesthetics" class="font-bebas btn btn-sm btn-liquid fs-5 px-3">
                                                 Reply
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.ContactMessageId" method="post" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                                <button type="submit" class="font-bebas btn btn-sm btn-outline-danger fs-5 px-3">
                                                     Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>