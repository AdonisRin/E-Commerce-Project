@model LiftAndAesthetics.ViewModels.ProductCatalogViewModel

@{
    ViewData["Title"] = "Gym Equipment & Supplements Catalog";
}

<div class="container-fluid text-center py-5 shadow-sm" style="background: linear-gradient(rgba(10,12,16,0.92), rgba(10,12,16,0.96)), url('/photos/weightlifting.png') center/cover; border-bottom: 2px solid #222632;">
    <h1 class="font-bebas display-2 text-uppercase text-white" style="letter-spacing: 3px;">Gym Shop & Equipment</h1>
    <p class="font-montserrat lead fw-bold text-light opacity-75 text-uppercase" style="letter-spacing: 1px;">High-grade supplements, apparel, and heavy lifting gear.</p>

    <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="font-bebas btn btn-danger fs-5 px-4 py-2" style="letter-spacing: 1px;">Add New Product</a>
            <a asp-action="Orders" class="font-bebas btn btn-outline-info fs-5 px-4 py-2" style="letter-spacing: 1px;">Manage Orders</a>
            <a asp-action="Dashboard" class="font-bebas btn btn-outline-light fs-5 px-4 py-2" style="letter-spacing: 1px;">Sales Dashboard</a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Orders" asp-action="Index" class="font-bebas btn btn-outline-light fs-5 px-4 py-2" style="letter-spacing: 1px;">My Orders</a>
            <a asp-controller="Wishlist" asp-action="Index" class="font-bebas btn btn-outline-danger fs-5 px-4 py-2" style="letter-spacing: 1px;">My Wishlist</a>
        }
    </div>
</div>

<div class="container mb-5 mt-4">
    <!-- Filter and Search Controls (A1, A2, B1: AJAX Live Search enabled) -->
    <form method="get" asp-action="Index" id="catalogFilterForm" class="p-3 mb-4 rounded" style="background: #141721; border: 1px solid #282e3e;">
        <div class="row g-3 align-items-end">
            <!-- Search Input (A2 - AJAX live as you type) -->
            <div class="col-12 col-md-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label text-uppercase font-montserrat fw-bold text-light small mb-0">Search Products</label>
                    <span class="badge bg-danger font-montserrat" id="ajaxSearchBadge" style="display: none; font-size: 0.7rem; letter-spacing: 0.5px;">Searching...</span>
                </div>
                <div class="input-group">
                    <input type="text"
                           name="search"
                           id="catalogSearchInput"
                           value="@Model.SearchQuery"
                           class="form-control bg-dark text-white border-secondary font-montserrat"
                           placeholder="Type to search (live AJAX)..."
                           autocomplete="off" />
                    <button type="button" class="btn btn-outline-secondary text-light" id="clearSearchBtn" title="Clear search">✕</button>
                </div>
            </div>

            <!-- Price Range (B1) with max protection -->
            <div class="col-6 col-md-2">
                <label class="form-label text-uppercase font-montserrat fw-bold text-light small mb-1">Min Price (LEI)</label>
                <input type="number" step="1" min="0" max="999999" name="minPrice" id="minPriceInput" value="@(Model.MinPrice > 0 ? Model.MinPrice.ToString() : "")" class="form-control bg-dark text-white border-secondary" placeholder="0" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label text-uppercase font-montserrat fw-bold text-light small mb-1">Max Price (LEI)</label>
                <input type="number" step="1" min="0" max="999999" name="maxPrice" id="maxPriceInput" value="@(Model.MaxPrice > 0 ? Model.MaxPrice.ToString() : "")" class="form-control bg-dark text-white border-secondary" placeholder="999" />
            </div>

            <!-- Sorting (B1) -->
            <div class="col-6 col-md-2">
                <label class="form-label text-uppercase font-montserrat fw-bold text-light small mb-1">Sort By</label>
                <select name="sortBy" id="sortBySelect" class="form-select bg-dark text-white border-secondary font-montserrat">
                    <option value="default" selected="@(Model.SortBy == "default")">Default</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
                    <option value="newest" selected="@(Model.SortBy == "newest")">Newest Arrivals</option>
                    <option value="rating" selected="@(Model.SortBy == "rating")">Highest Rated</option>
                </select>
            </div>

            <!-- Action Buttons & InStock -->
            <div class="col-6 col-md-2 d-flex flex-column justify-content-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="inStock" value="true" id="inStockCheck" @(Model.InStockOnly ? "checked" : "") />
                    <label class="form-check-label text-light font-montserrat small" for="inStockCheck">
                        In Stock Only
                    </label>
                </div>
                <button type="submit" class="btn btn-danger font-bebas fs-5 w-100 py-1" style="letter-spacing: 1px;">Filter</button>
            </div>
        </div>

        <input type="hidden" name="category" id="selectedCategoryInput" value="@Model.SelectedCategory" />
        <input type="hidden" name="page" id="currentPageInput" value="@Model.CurrentPage" />
    </form>

    <!-- Category Pills Tabs (A1, B1: preserved in URL) -->
    <div class="d-flex flex-wrap gap-2 justify-content-center mb-4 pb-2 border-bottom border-secondary" id="categoryPillsContainer">
        @{
            string[] categories = new[] { "All", "Supplements", "Clothing", "Equipment", "Accessories" };
        }
        @foreach (var cat in categories)
        {
            bool isActive = Model.SelectedCategory.Equals(cat, StringComparison.OrdinalIgnoreCase);
            <a href="javascript:void(0)"
               onclick="selectCategory(event, '@cat')"
               data-category="@cat"
               class="btn category-pill @(isActive ? "btn-danger" : "btn-outline-secondary text-white") font-bebas fs-5 px-4"
               style="letter-spacing: 1px;">
                @cat.ToUpper()
            </a>
        }
    </div>

    <!-- Product Grid & Pagination Container (AJAX Target) -->
    <div id="catalogResultsArea" style="position: relative; min-height: 250px;">
        <partial name="_ProductGridPartial" model="Model" />
    </div>
</div>

@section Scripts {
<script>
    let liveSearchDebounceTimer = null;

    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('catalogSearchInput');
        const form = document.getElementById('catalogFilterForm');
        const clearBtn = document.getElementById('clearSearchBtn');
        const sortBySelect = document.getElementById('sortBySelect');
        const inStockCheck = document.getElementById('inStockCheck');
        const minPriceInput = document.getElementById('minPriceInput');
        const maxPriceInput = document.getElementById('maxPriceInput');

        // A2 Live AJAX Search as the user types (no Enter required)
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                clearTimeout(liveSearchDebounceTimer);
                showSearchBadge(true);
                liveSearchDebounceTimer = setTimeout(function () {
                    document.getElementById('currentPageInput').value = '1';
                    performAjaxCatalogUpdate();
                }, 220); // 220ms debounce for responsive instant feel
            });
        }

        // Clear button clears search input and updates immediately
        if (clearBtn && searchInput) {
            clearBtn.addEventListener('click', function () {
                searchInput.value = '';
                searchInput.focus();
                document.getElementById('currentPageInput').value = '1';
                performAjaxCatalogUpdate();
            });
        }

        // Live update on filter inputs change
        [sortBySelect, inStockCheck, minPriceInput, maxPriceInput].forEach(elem => {
            if (elem) {
                elem.addEventListener('change', function () {
                    clearTimeout(liveSearchDebounceTimer);
                    document.getElementById('currentPageInput').value = '1';
                    performAjaxCatalogUpdate();
                });
            }
        });

        // Intercept form submit so pressing Enter or clicking Filter button also triggers smooth AJAX
        if (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearTimeout(liveSearchDebounceTimer);
                document.getElementById('currentPageInput').value = '1';
                performAjaxCatalogUpdate();
            });
        }
    });

    function showSearchBadge(show) {
        const badge = document.getElementById('ajaxSearchBadge');
        if (badge) {
            badge.style.display = show ? 'inline-block' : 'none';
        }
    }

    function selectCategory(event, catName) {
        if (event) event.preventDefault();
        const catInput = document.getElementById('selectedCategoryInput');
        if (catInput) catInput.value = catName;

        // Update pill active classes
        document.querySelectorAll('.category-pill').forEach(pill => {
            if (pill.getAttribute('data-category').toLowerCase() === catName.toLowerCase()) {
                pill.classList.remove('btn-outline-secondary', 'text-white');
                pill.classList.add('btn-danger');
            } else {
                pill.classList.remove('btn-danger');
                pill.classList.add('btn-outline-secondary', 'text-white');
            }
        });

        document.getElementById('currentPageInput').value = '1';
        performAjaxCatalogUpdate();
    }

    function navigatePage(pageNum) {
        document.getElementById('currentPageInput').value = pageNum;
        performAjaxCatalogUpdate();
        // Smooth scroll up to product container
        const target = document.getElementById('catalogFilterForm');
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function resetAllFilters(event) {
        if (event) event.preventDefault();
        const searchInput = document.getElementById('catalogSearchInput');
        const minPriceInput = document.getElementById('minPriceInput');
        const maxPriceInput = document.getElementById('maxPriceInput');
        const sortBySelect = document.getElementById('sortBySelect');
        const inStockCheck = document.getElementById('inStockCheck');
        const catInput = document.getElementById('selectedCategoryInput');
        const pageInput = document.getElementById('currentPageInput');

        if (searchInput) searchInput.value = '';
        if (minPriceInput) minPriceInput.value = '';
        if (maxPriceInput) maxPriceInput.value = '';
        if (sortBySelect) sortBySelect.value = 'default';
        if (inStockCheck) inStockCheck.checked = false;
        if (catInput) catInput.value = 'All';
        if (pageInput) pageInput.value = '1';

        document.querySelectorAll('.category-pill').forEach(pill => {
            if (pill.getAttribute('data-category').toLowerCase() === 'all') {
                pill.classList.remove('btn-outline-secondary', 'text-white');
                pill.classList.add('btn-danger');
            } else {
                pill.classList.remove('btn-danger');
                pill.classList.add('btn-outline-secondary', 'text-white');
            }
        });

        performAjaxCatalogUpdate();
    }

    function performAjaxCatalogUpdate() {
        const form = document.getElementById('catalogFilterForm');
        const resultsArea = document.getElementById('catalogResultsArea');
        if (!form || !resultsArea) return;

        const formData = new FormData(form);
        const params = new URLSearchParams(formData);
        params.set('ajax', 'true');

        resultsArea.style.opacity = '0.45';
        resultsArea.style.transition = 'opacity 0.15s ease';

        const requestUrl = '@Url.Action("Index", "Shop")?' + params.toString();

        fetch(requestUrl, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) throw new Error('Network error during catalog AJAX fetch.');
            return response.text();
        })
        .then(html => {
            resultsArea.innerHTML = html;
            resultsArea.style.opacity = '1';
            showSearchBadge(false);

            // B1: Maintain filter & search parameters in the browser URL without page refresh
            params.delete('ajax');
            const cleanUrl = window.location.pathname + '?' + params.toString();
            window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
        })
        .catch(err => {
            console.error('AJAX Catalog update error:', err);
            resultsArea.style.opacity = '1';
            showSearchBadge(false);
        });
    }
</script>
}
