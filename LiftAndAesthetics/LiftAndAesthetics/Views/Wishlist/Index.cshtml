@model IEnumerable<LiftAndAesthetics.Models.WishlistItem>

@{
    ViewData["Title"] = "My Saved Favourites & Wishlist";
}

<div class="container-fluid text-center py-5 shadow-sm" style="background: linear-gradient(rgba(10,12,16,0.92), rgba(10,12,16,0.96)), url('/photos/weightlifting.png') center/cover; border-bottom: 2px solid #222632;">
    <h1 class="font-bebas display-3 text-uppercase text-white" style="letter-spacing: 2px;">Saved Favourites & Wishlist</h1>
    <p class="font-montserrat lead text-secondary text-uppercase" style="letter-spacing: 1px;">Keep track of equipment and supplements you plan to purchase next.</p>
</div>

<div class="container my-5">
    @if (!Model.Any())
    {
        <div class="text-center p-5 rounded" style="background: #141721; border: 1px dashed #303749;">
            <h3 class="font-bebas text-white fs-3 mb-2">Your Wishlist is Empty</h3>
            <p class="font-montserrat text-secondary mb-4">You haven't saved any items yet. Browse the catalog to add products to your wishlist.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-danger font-bebas fs-4 px-4 py-2">Explore Catalog</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                var prod = item.Product;
                if (prod == null) continue;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm text-white" style="background: #141721; border-top: 3px solid #dc3545 !important; border-radius: 8px;">
                        <div class="p-3 text-center position-relative" style="background: #0f1219; min-height: 200px; display: flex; align-items: center; justify-content: center;">
                            <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "https://via.placeholder.com/300/111/dc3545" : prod.ImageUrl)"
                                 class="img-fluid" style="max-height: 160px; object-fit: contain;" alt="@prod.Name" />

                            <span class="badge bg-danger position-absolute top-0 start-0 m-2 font-bebas">@prod.Category</span>
                        </div>

                        <div class="card-body p-4 d-flex flex-column">
                            <h4 class="font-bebas text-white fs-4 mb-1">
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@prod.ProductId" class="text-white text-decoration-none">
                                    @prod.Name
                                </a>
                            </h4>
                            <div class="small font-montserrat mb-3" style="color: #cbd5e1;">Saved on @item.AddedDate.ToString("dd MMM yyyy")</div>

                            <div class="d-flex justify-content-between align-items-baseline mb-3">
                                <div class="font-bebas text-danger fs-3">@prod.Price.ToString("0.00") LEI</div>
                                <div>
                                    @if (prod.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success font-montserrat small">In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary font-montserrat small">Out of Stock</span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-column mt-auto">
                                <!-- B7: Option to move items to the cart -->
                                <form asp-action="MoveToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@prod.ProductId" />
                                    <button type="submit" class="btn btn-danger font-bebas fs-5 w-100 py-2" @(prod.StockQuantity <= 0 ? "disabled" : "") style="letter-spacing: 1px;">
                                        Move to Cart
                                    </button>
                                </form>

                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@prod.ProductId" />
                                    <button type="submit" class="btn btn-outline-secondary font-montserrat btn-sm w-100 py-1 text-light">
                                        Remove from Wishlist
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

