@model LiftAndAesthetics.Models.FitnessClass

@{
    ViewData["Title"] = "Class Details";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card-cyber-glow bg-black border-0 p-4 p-md-5 text-center" style="border-top: 5px solid #dc3545 !important;">

                @if (!string.IsNullOrEmpty(Model.MainPhotoUrl))
                {
                    <div class="overflow-hidden rounded mb-4 mx-auto" style="border: 3px solid #dc3545; box-shadow: 0 0 20px rgba(220, 53, 69, 0.4); max-width: 100%;">
                        <img src="@Model.MainPhotoUrl" class="img-fluid w-100 img-zoom-extreme" style="max-height: 400px; object-fit: cover;" alt="@Model.ClassName">
                    </div>
                }

                <h1 class="font-bebas text-neon-red text-uppercase mb-2 text-hologram" style="letter-spacing: 3px; font-size: 3.5rem;">@Model.ClassName</h1>

                <p class="font-montserrat text-crisp-white fs-4 fw-bold mb-4">
                     Schedule: <span class="text-neon-red">@Model.ScheduleTime.ToString("f")</span>
                </p>

                <p class="font-montserrat lead text-crisp-white opacity-75 mb-4 px-md-4">@Model.Description</p>

                <div class="bg-dark p-3 rounded border border-secondary shadow-sm mx-auto mb-4" style="max-width: 300px;">
                    <h4 class="font-bebas mb-0 text-white" style="letter-spacing: 1px;">
                        Trainer: <span class="text-neon-red">@(Model.Trainer != null ? Model.Trainer.Name : "TBA")</span>
                    </h4>
                </div>

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <a href="@Model.VideoUrl" target="_blank" class="font-bebas btn btn-liquid fs-3 px-5 mb-4 btn-firework" style="letter-spacing: 2px;">▶ Watch Promo Video</a>
                }

                <div class="mt-4 border-top border-secondary pt-4 d-flex justify-content-center gap-3 flex-wrap">
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/FitnessClasses/Edit/@Model.FitnessClassId" class="font-bebas btn btn-warning fs-4 px-5 text-dark">Edit Class</a>
                    }
                    <a href="/FitnessClasses" class="font-bebas btn btn-outline-light fs-4 px-5">Back to Classes</a>
                </div>

            </div>
        </div>
    </div>
</div>