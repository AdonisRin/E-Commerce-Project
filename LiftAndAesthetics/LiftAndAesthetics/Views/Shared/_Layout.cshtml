@using LiftAndAesthetics.Services.Interfaces
@* @inject IChatService ChatService *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Lift & Aesthetics</title>
    <link rel="icon" type="image/png" href="~/photos/ganterafata.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/styles.css" rel="stylesheet">
    <style>
            @@keyframes pulse-glow {
                0% {
                    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.8);
                }

                70% {
                    box-shadow: 0 0 0 10px rgba(220, 53, 69, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
                }
            }

            .badge-pulse {
                animation: pulse-glow 1.5s infinite;
            }
    </style>
</head>
<body id="top" class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-xl bg-black navbar-dark sticky-top shadow-lg py-3" style="border-bottom: 3px solid #333;">
        <div class="container-fluid px-lg-5">
            <a class="navbar-brand d-flex align-items-center" href="/Home">
                <img src="~/photos/ganterafata.png" alt="Lift & Aesthetics" class="me-3" style="width: 44px; height: 44px; object-fit: contain;" />
                <span class="navbar-brand-text text-white fw-bold" style="font-size: 1.2rem; letter-spacing: 1px;">LIFT <span class="text-danger" style="font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: 0.9em; margin: 0 3px; vertical-align: baseline;">&</span> AESTHETICS</span>
            </a>

            <button class="navbar-toggler border-danger text-danger" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="collapsibleNavbar">
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();

                    /* Chat unread counter disabled for demo
                    int unreadMessages = 0;
                    if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        unreadMessages = await ChatService.GetUnreadCountAsync(User.Identity.Name);
                    }
                    */
                }

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link @(currentController == "FitnessClasses" ? "active" : "")" href="/FitnessClasses">Classes</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Trainers" ? "active" : "")" href="/Trainers">Trainers</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Memberships" ? "active" : "")" href="/Memberships">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link text-warning @(currentController == "Shop" ? "active" : "")" href="/Shop">Inventory</a></li>

                        @* Chat Admin Inbox link disabled for demo
                        <li class="nav-item ms-lg-2 mt-3 mt-lg-0">
                            <a class="btn btn-outline-warning btn-liquid btn-sm fw-bold px-4 py-2 text-uppercase letter-spacing-1 d-flex align-items-center gap-2" href="/Chat">
                                Inbox
                                @if (unreadMessages > 0)
                                {
                                    <span class="badge rounded-pill bg-danger border border-dark badge-pulse fs-6 px-2">
                                        @unreadMessages
                                    </span>
                                }
                            </a>
                        </li>
                        *@
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            <a class="btn btn-outline-info btn-liquid btn-sm fw-bold px-4 py-2 text-uppercase letter-spacing-1" href="/Members">Users</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @(currentController == "FitnessClasses" ? "active" : "")" href="/FitnessClasses">Classes</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Trainers" ? "active" : "")" href="/Trainers">Trainers</a></li>
                        <li class="nav-item"><a class="nav-link @(currentController == "Memberships" ? "active" : "")" href="/Memberships">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link text-success @(currentController == "Shop" ? "active" : "")" href="/Shop">Shop</a></li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item ms-lg-2 mt-3 mt-lg-0">
                                <a class="btn btn-outline-info btn-liquid btn-sm fw-bold px-4 py-2 text-uppercase letter-spacing-1 d-flex align-items-center gap-2" href="/ContactMessages/Create">
                                    Contact Support
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2 mt-3 mt-lg-0">
                                <a class="btn btn-outline-secondary btn-liquid btn-sm fw-bold px-4 py-2 text-uppercase letter-spacing-1" href="/ContactMessages/Create">
                                    Contact Support
                                </a>
                            </li>
                        }
                    }
                </ul>

                <div class="ms-lg-4 border-start border-secondary ps-lg-4 mt-3 mt-lg-0 d-flex align-items-center justify-content-center">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 text-center shadow fw-bold border-2 border-success" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <strong>Success!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3 text-center shadow fw-bold border-2 border-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Oops!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="mt-auto py-4 bg-black text-white text-center border-top border-danger border-2">
        <div class="container">
            <p class="mb-0 fw-bold" style="font-family: 'Montserrat', sans-serif; letter-spacing: 1px;">
                <span class="text-danger">© 2026</span> LIFT & AESTHETICS. ALL RIGHTS RESERVED.
            </p>
        </div>
    </footer>

    <a href="#top" id="btn-up" class="btn btn-liquid rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; z-index: 1000; opacity: 0.8; transition: opacity 0.3s;" title="Mergi sus">
        <span class="fs-4 fw-bold text-white">↑</span>
    </a>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(window).scroll(function () {
            if ($(window).scrollTop() > 50) {
                $('.navbar').css('background-color', 'rgba(0, 0, 0, 0.95)').css('transition', '0.3s');
            } else {
                $('.navbar').css('background-color', '#000');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>