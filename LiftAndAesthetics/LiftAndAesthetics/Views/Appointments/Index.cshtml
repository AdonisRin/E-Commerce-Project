@model IEnumerable<LiftAndAesthetics.Models.ClassReservation>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container-fluid text-center py-5 shadow-lg" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%); border-bottom: 3px solid #0dcaf0;">
    <h1 class="font-bebas display-2 text-uppercase text-crisp-white glitch-text" style="letter-spacing: 4px; text-shadow: 0 0 20px rgba(13, 202, 240, 0.5);"> My Appointments</h1>
    <p class="font-montserrat lead fw-bold text-crisp-white opacity-75 text-uppercase" style="letter-spacing: 1px;">Your upcoming battles in the gym.</p>
</div>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card-cyber-glow bg-black p-4 p-md-5" style="border: 1px solid #333; border-top: 5px solid #0dcaf0; border-radius: 15px;">

                @if (!Model.Any())
                {
                    <div class="p-5 text-center rounded-4 shadow-lg" style="background: rgba(13, 202, 240, 0.05); border: 2px dashed #0dcaf0;">
                        <h2 class="font-bebas text-info mb-3 text-hologram" style="font-size: 3rem; letter-spacing: 2px;">NO RESERVATIONS YET</h2>
                        <p class="font-montserrat text-crisp-white fs-5 fw-bold">You haven't booked any classes. Time to hit the iron!</p>
                        <a href="/FitnessClasses" class="font-bebas btn btn-liquid fs-4 px-5 py-2 mt-4" style="letter-spacing: 2px;">BROWSE CLASSES</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 font-montserrat">
                            <thead class="font-bebas fs-4 text-info" style="letter-spacing: 1px;">
                                <tr>
                                    <th>Class Name</th>
                                    <th>Booked On</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var res in Model)
                                {
                                    <tr style="border-bottom: 1px solid #222;">
                                        <td class="fw-bold text-white fs-5">@res.FitnessClass?.ClassName</td>
                                        <td class="text-secondary fw-bold">@res.ReservationDate.ToString("dd MMM yyyy - HH:mm")</td>
                                        <td>
                                            <span class="badge bg-success text-white">Confirmed</span>
                                        </td>
                                        <td class="text-end">
                                            <form asp-controller="Appointments" asp-action="Cancel" method="post" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                                                <input type="hidden" name="id" value="@res.ClassReservationId" />
                                                <button type="submit" class="font-bebas btn btn-sm btn-outline-danger fs-5 px-3">CANCEL</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>