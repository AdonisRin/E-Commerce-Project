@* CHAT FEATURE COMMENTED OUT FOR DEMO
@model IEnumerable<LiftAndAesthetics.Models.ChatMessage>
@{
    string currentUser = User.Identity.Name;
    string chatWith = ViewBag.ChatWith;
    bool isCurrentUserAdmin = User.IsInRole("Admin");
}

<div class="container py-5">
    <div class="card-cyber-glow bg-black p-0 overflow-hidden shadow-lg" style="height: 700px; display: flex; flex-direction: column; border: 1px solid #333; border-top: 4px solid #dc3545;">

        <div class="bg-dark p-3 border-bottom border-danger d-flex justify-content-between align-items-center">
            <h4 class="font-bebas text-white mb-0" style="letter-spacing: 2px;"> LIVE CHAT @(isCurrentUserAdmin ? $"- {chatWith}" : "SUPPORT")</h4>
            @if (isCurrentUserAdmin)
            {
                <a href="/Chat" class="btn btn-sm btn-outline-info font-bebas">BACK TO INBOX</a>
            }
        </div>

        <div class="chat-box p-4 flex-grow-1 overflow-auto" id="chatWindow" style="background: #050505;">
            @foreach (var msg in Model)
            {
                var isMine = msg.SenderEmail == currentUser;
                var isAdminMessage = msg.SenderEmail == "admin@lift.com";

                <div class="d-flex @(isMine ? "justify-content-end" : "justify-content-start") mb-4">
                    <div class="message-bubble p-3 @(isMine ? "bg-danger text-white" : "bg-dark text-white border border-secondary") position-relative"
                         style="max-width: 75%; min-width: 200px; border-radius: 15px; @(isMine ? "border-bottom-right-radius: 2px;" : "border-bottom-left-radius: 2px;") box-shadow: 0 5px 15px rgba(0,0,0,0.3);">

                        @if (!isMine && isAdminMessage)
                        {
                            <div class="font-bebas text-warning mb-1" style="font-size: 0.8rem; letter-spacing: 1px;"> ADMIN</div>
                        }
                        else if (!isMine)
                        {
                            <div class="font-bebas text-info mb-1" style="font-size: 0.8rem; letter-spacing: 1px;"> ATHLETE</div>
                        }

                        <p class="mb-1 font-montserrat fw-bold" style="font-size: 0.95rem; word-wrap: break-word;">
                            @msg.Content
                            @if (msg.IsEdited)
                            {
                                <small class="text-white-50 ms-1" style="font-size: 0.7rem;"><i>(edited)</i></small>
                            }
                        </p>

                        @if (!string.IsNullOrEmpty(msg.AttachmentUrl))
                        {
                            <div class="mt-2 rounded overflow-hidden border border-light">
                                <img src="@msg.AttachmentUrl" class="img-fluid" style="max-height: 250px; cursor: pointer;" onclick="window.open(this.src)" />
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-2 opacity-75" style="font-size: 0.7rem;">
                            <span>@msg.Timestamp.ToString("dd MMM, HH:mm")</span>

                            <div class="d-flex gap-2 align-items-center">
                                @if (isMine)
                                {
                                    <button type="button" class="btn btn-sm text-light p-0" title="Edit" data-msg-id="@msg.Id" data-msg-content="@msg.Content" onclick="openEditModal(this)"></button>
                                }
                                @if (isMine || isCurrentUserAdmin)
                                {
                                    <form asp-action="Delete" method="post" class="m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                        <input type="hidden" name="id" value="@msg.Id" />
                                        <input type="hidden" name="receiverEmail" value="@chatWith" />
                                        <button type="submit" class="btn btn-sm text-light p-0" title="Delete"></button>
                                    </form>
                                }
                                @if (isMine)
                                {
                                    <span class="ms-1">@(msg.IsRead ? "" : "")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <form asp-action="Send" method="post" enctype="multipart/form-data" class="p-3 bg-dark border-top border-secondary">
            <input type="hidden" name="receiverEmail" value="@chatWith" />
            <div class="input-group gap-2">
                <label class="btn btn-outline-info mb-0 d-flex align-items-center justify-content-center" style="width: 50px; cursor: pointer;">
                     <input type="file" name="attachment" hidden onchange="this.form.submit()">
                </label>
                <input type="text" name="content" class="form-control input-hologram" placeholder="Type your message here..." required autocomplete="off">
                <button type="submit" class="font-bebas btn btn-liquid px-4 py-2">SEND</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-black border border-info shadow-lg">
            <form asp-action="Edit" method="post">
                <div class="modal-body p-4">
                    <h5 class="text-info font-bebas mb-3" style="letter-spacing: 1px;"> EDIT MESSAGE</h5>
                    <input type="hidden" name="id" id="editMessageId" />
                    <input type="hidden" name="receiverEmail" value="@chatWith" />
                    <textarea name="newContent" id="editMessageContent" class="form-control input-hologram font-montserrat" rows="3" required></textarea>
                    <div class="mt-4 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary font-bebas" data-bs-dismiss="modal">CANCEL</button>
                        <button type="submit" class="btn btn-info font-bebas">SAVE CHANGES</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var chatWindow = document.getElementById("chatWindow");
        chatWindow.scrollTop = chatWindow.scrollHeight;

        function openEditModal(btn) {
            var msgId = btn.getAttribute('data-msg-id');
            var msgContent = btn.getAttribute('data-msg-content');

            document.getElementById('editMessageId').value = msgId;
            document.getElementById('editMessageContent').value = msgContent;

            var editModal = new bootstrap.Modal(document.getElementById('editModal'));
            editModal.show();
        }
    </script>
}
*@