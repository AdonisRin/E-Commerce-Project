@model LiftAndAesthetics.Models.Trainer

@{
    ViewData["Title"] = "Trainer Details";
}

<div class="container mt-5 mb-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="p-5 rounded-4 shadow-lg text-center card-cyber-glow" style="background: #0a0a0a; border: 1px solid #333; border-top: 5px solid #dc3545;">

                <div class="overflow-hidden rounded-circle mx-auto mb-4" style="width: 180px; height: 180px; border: 4px solid #dc3545; box-shadow: 0 0 15px rgba(220, 53, 69, 0.4);">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? "https://via.placeholder.com/200/111/dc3545?text=+" : Model.PhotoUrl)"
                         class="img-fluid h-100 w-100 img-zoom-extreme" style="object-fit: cover;" alt="@Model.Name">
                </div>

                <h1 class="font-bebas text-crisp-white text-uppercase mb-1 text-hologram" style="font-size: 3.5rem; letter-spacing: 2px;">@Model.Name</h1>
                <h4 class="font-montserrat text-neon-red fw-bolder text-uppercase mb-4 text-hologram" style="letter-spacing: 1px;">@Model.Specialization</h4>

                <div class="bg-dark p-4 rounded-4 border border-secondary text-start mb-4">
                    <p class="font-montserrat fst-italic text-center text-crisp-white opacity-75 fs-5 mb-4">"@Model.Motto"</p>
                    <hr class="border-secondary mb-4" />
                    <p class="font-montserrat text-crisp-white fs-5 mb-2"><strong class="text-neon-red">Experience:</strong> @Model.Experience</p>
                    <p class="font-montserrat text-crisp-white fs-5 mb-2"><strong class="text-neon-red">Availability:</strong> @Model.Availability</p>
                    <p class="font-montserrat text-crisp-white fs-5 mb-0"><strong class="text-neon-red">Phone:</strong> @Model.PhoneNumber</p>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Trainers/Edit/@Model.TrainerId" class="font-bebas btn btn-warning fs-4 px-5 text-dark">Edit Info</a>
                    }
                    <a href="/Trainers" class="font-bebas btn btn-outline-light fs-4 px-5">Back to List</a>
                </div>

            </div>
        </div>
    </div>
</div>