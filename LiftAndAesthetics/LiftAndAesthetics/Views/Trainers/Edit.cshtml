@model LiftAndAesthetics.Models.Trainer

@{
    ViewData["Title"] = "Edit Trainer";
}

<div class="container-fluid text-center py-5 shadow-lg" style="background: linear-gradient(rgba(10,10,10,0.85), rgba(10,10,10,0.95)), url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=2070') center/cover; border-bottom: 3px solid #ffc107;">
    <h1 class="font-bebas display-2 text-uppercase text-crisp-white glitch-text" style="letter-spacing: 4px; text-shadow: 0 0 20px rgba(255, 193, 7, 0.5);"> Edit Trainer Profile</h1>
    <p class="font-montserrat lead fw-bold text-crisp-white opacity-75 text-uppercase" style="letter-spacing: 1px;">Update the details for <strong>@Model.Name</strong>.</p>
</div>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="p-4 p-md-5 rounded-4 shadow-lg card-cyber-glow" style="background: linear-gradient(145deg, #111 0%, #1a0505 100%); border: 1px solid #333; border-top: 5px solid #ffc107;">

                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold font-montserrat mb-3"></div>

                    <input type="hidden" asp-for="TrainerId" />
                    <input type="hidden" asp-for="PhotoUrl" />

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Name" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Full Name</label>
                            <input asp-for="Name" class="form-control input-hologram font-montserrat p-3" required />
                            <span asp-validation-for="Name" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Specialization" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Specialization</label>
                            <input asp-for="Specialization" class="form-control input-hologram font-montserrat p-3" required />
                            <span asp-validation-for="Specialization" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="PhoneNumber" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control input-hologram font-montserrat p-3" />
                            <span asp-validation-for="PhoneNumber" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Experience" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Experience</label>
                            <input asp-for="Experience" class="form-control input-hologram font-montserrat p-3" />
                            <span asp-validation-for="Experience" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-12 mb-4">
                            <label asp-for="Availability" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Availability</label>
                            <input asp-for="Availability" class="form-control input-hologram font-montserrat p-3" />
                            <span asp-validation-for="Availability" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-12 mb-4">
                            <label asp-for="Motto" class="form-label font-montserrat text-crisp-white fw-bold text-uppercase" style="letter-spacing: 1px;">Motto / Quote</label>
                            <input asp-for="Motto" class="form-control input-hologram font-montserrat p-3" />
                            <span asp-validation-for="Motto" class="text-danger font-montserrat small fw-bold"></span>
                        </div>

                        <div class="col-md-12 mb-4 border-top border-secondary pt-4 mt-2">
                            <label class="form-label font-montserrat text-warning fw-bold text-uppercase" style="letter-spacing: 1px;"> Upload New Photo (Optional)</label>
                            <input type="file" name="photoFile" class="form-control input-hologram font-montserrat p-3" accept=".jpg, .jpeg, .png" />
                            <small class="text-muted font-montserrat fw-bold mt-2 d-block">Leave this empty to keep the current photo.</small>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4 pt-3 border-top border-secondary">
                        <button type="submit" class="font-bebas btn btn-warning fs-3 px-5 py-2 flex-grow-1" style="letter-spacing: 2px;">Save Changes</button>
                        <a asp-action="Index" class="font-bebas btn btn-outline-light fs-3 px-5 py-2">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}